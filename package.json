{
  "name": "dsh-vision",
  "version": "0.1.0",
  "description": "Local vision bridge for DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./durable-descriptions": {
      "types": "./lib/durable-descriptions.d.ts",
      "default": "./lib/durable-descriptions.js"
    },
    "./transformers-backend": {
      "types": "./lib/transformers-backend.d.ts",
      "default": "./lib/transformers-backend.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "lib/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "pnpm run build"
  },
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "@huggingface/transformers": "3.8.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-attachment": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-attachment": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@types/node": "^22.20.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4",
    "yaml": "^2.9.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaoshihou514/dsh-vision.git"
  },
  "homepage": "https://github.com/xiaoshihou514/dsh-vision#readme",
  "bugs": "https://github.com/xiaoshihou514/dsh-vision/issues",
  "keywords": ["deepseek", "deepseek-harness", "vision", "multimodal", "florence-2"],
  "publishConfig": {
    "access": "public"
  }
}
