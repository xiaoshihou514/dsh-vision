{
  "name": "dsh-vision",
  "version": "0.1.0",
  "description": "Local vision bridge for DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./qwen-backend": {
      "types": "./lib/qwen-backend.d.ts",
      "default": "./lib/qwen-backend.js"
    },
    "./glm-backend": {
      "types": "./lib/glm-backend.d.ts",
      "default": "./lib/glm-backend.js"
    },
    "./vision-tool": {
      "types": "./lib/vision-tool.d.ts",
      "default": "./lib/vision-tool.js"
    },
    "./vision-preprocessor": {
      "types": "./lib/vision-preprocessor.d.ts",
      "default": "./lib/vision-preprocessor.js"
    },
    "./settings-api": {
      "types": "./lib/settings-api.d.ts",
      "default": "./lib/settings-api.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    }
  },
  "files": [
    "lib/*.js",
    "lib/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/prepare-dist.mjs && tsdown && node scripts/finalize-dist.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "pnpm run build"
  },
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "@huggingface/transformers": "4.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-attachment": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-credentials": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-attachment": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-credentials": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "@types/node": "^22.20.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "unrun": "^0.3.1",
    "vitest": "^3.2.4",
    "yaml": "^2.9.0",
    "react": "^18.2.0",
    "@types/react": "^18.2.0",
    "@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-connection": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "^0.1.1-rc.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaoshihou514/dsh-vision.git"
  },
  "homepage": "https://github.com/xiaoshihou514/dsh-vision#readme",
  "bugs": "https://github.com/xiaoshihou514/dsh-vision/issues",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "vision",
    "multimodal",
    "qwen3-vl"
  ],
  "publishConfig": {
    "access": "public"
  }
}
